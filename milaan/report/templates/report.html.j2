<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Milaan reconciliation report</title>
  <style>
    :root { --ink:#181711; --muted:#666254; --paper:#f8f5ec; --card:#fffdf7; --gold:#b18435; --green:#167454; --red:#a23a32; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:var(--paper); font:15px/1.55 system-ui,-apple-system,Segoe UI,sans-serif; }
    main { max-width:1120px; margin:auto; padding:42px 28px 80px; }
    h1 { font-size:42px; margin:0 0 4px; letter-spacing:-1.5px; }
    h2 { margin-top:44px; border-bottom:2px solid #ded7c7; padding-bottom:8px; }
    h3 { margin:0 0 8px; }
    .eyebrow { color:var(--gold); font-weight:800; letter-spacing:2px; text-transform:uppercase; }
    .muted { color:var(--muted); }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:14px; }
    .card { background:var(--card); border:1px solid #ded7c7; border-radius:14px; padding:18px; box-shadow:0 3px 18px #554a3010; }
    .value { font-size:26px; font-weight:800; color:var(--ink); overflow-wrap:anywhere; }
    .value.good { color:var(--green); }
    .value.bad { color:var(--red); }
    .note { color:var(--muted); font-size:12px; margin-top:4px; }
    .lede { font-size:19px; max-width:62ch; }
    .loop { font-weight:700; color:var(--gold); letter-spacing:.3px; margin:6px 0 22px; }
    .callout { background:#fff6df; border-left:4px solid var(--gold); border-radius:0 10px 10px 0; padding:12px 16px; }
    .trace { display:grid; gap:6px; justify-items:stretch; margin:18px 0; }
    .trace .step { background:var(--card); border:1px solid #ded7c7; border-radius:12px; padding:14px 18px; }
    tr.traced { background:#fff6df; font-weight:700; }
    .trace .arrow { text-align:center; color:var(--gold); font-size:20px; font-weight:800; }
    table { width:100%; border-collapse:collapse; background:var(--card); }
    th,td { border-bottom:1px solid #e6dfcf; padding:10px; text-align:left; vertical-align:top; }
    th { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.7px; }
    code { background:#eee8d9; padding:2px 5px; border-radius:5px; overflow-wrap:anywhere; }
    mark { background:#ffe08a; padding:2px; border-radius:3px; }
    .evidence { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    details { background:var(--card); border:1px solid #ded7c7; border-radius:10px; padding:10px 14px; margin:8px 0; }
    summary { cursor:pointer; font-weight:750; }
    pre { white-space:pre-wrap; overflow-wrap:anywhere; font-size:12px; background:#24231f; color:#f7f2e6; padding:12px; border-radius:8px; }
    .pass { color:var(--green); font-weight:750; }
    .warning { color:var(--red); font-weight:750; }
    footer { margin-top:50px; color:var(--muted); font-size:12px; }
    @media(max-width:700px){ .evidence{grid-template-columns:1fr} h1{font-size:32px} }
    @media print { body{background:white} main{max-width:none;padding:16mm} .card,details{break-inside:avoid;box-shadow:none} }
  </style>
</head>
<body><main>$content</main></body>
</html>
