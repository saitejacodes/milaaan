# Offline demos do not read this file. These values are used only with --llm live.
# Providers: openai-compatible | ollama | anthropic | gemini
# Optional: MILAAN_ENV_FILE=/absolute/path/to/a/different.env
MILAAN_LLM_PROVIDER=openai-compatible
MILAAN_LLM_MODEL=
MILAAN_LLM_API_KEY=
# Required for openai-compatible. Ollama/Anthropic/Gemini have safe defaults.
MILAAN_LLM_BASE_URL=
# native asks the API for JSON mode; use prompt for a compatible server without it.
MILAAN_LLM_JSON_MODE=native
MILAAN_LLM_MAX_TOKENS=600
MILAAN_LLM_TIMEOUT_SECONDS=30
MILAAN_LLM_PRICE_IN_PAISE_PER_1K=0
MILAAN_LLM_PRICE_OUT_PAISE_PER_1K=0
MILAAN_CACHE_PATH=data/.llm_cache.sqlite
